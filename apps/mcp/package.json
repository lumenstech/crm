{
  "name": "@crm/mcp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --outdir dist --packages=external --sourcemap",
    "check-types": "tsc --noEmit",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:prod": "bun dist/index.js",
    "lint": "biome check .",
    "test": "bun test",
    "clean": "rm -rf .turbo dist node_modules"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crm/typescript-config": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "typescript": "5.9.2"
  }
}
