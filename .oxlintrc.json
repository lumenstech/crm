{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": [],
	"categories": {
		"correctness": "off"
	},
	"jsPlugins": [
		"./tools/oxlint/anti-slop/index.ts"
	],
	"ignorePatterns": [
		"**/node_modules/**",
		"**/dist/**",
		"**/.next/**",
		"**/.eve/**",
		"**/.scratch/**",
		".agents/**",
		".claude/**",
		"apps/api/src/generated/**",
		"packages/db/src/generated/**",
		"packages/ui/src/components/**",
		"tools/oxlint/anti-slop/**"
	],
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "off",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error"
	},
	"overrides": [
		{
			"files": [
				"**/test/**",
				"**/tests/**",
				"**/evals/**",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/*.eval.ts"
			],
			"rules": {
				"anti-slop/no-chained-type-assertions": "off"
			}
		},
		{
			"files": [
				"packages/validation/src/**"
			],
			"rules": {
				"anti-slop/no-unknown-parameters": "off"
			}
		},
		{
			"files": [
				"packages/telemetry/src/**",
				"apps/api/src/logging/**",
				"packages/db/src/fields.ts",
				"packages/db/src/fields-shape.ts",
				"apps/api/src/fields/**",
				"apps/app/components/crm/inline-field.tsx"
			],
			"rules": {
				"anti-slop/no-unsafe-dictionary-type": "off",
				"anti-slop/no-unknown-parameters": "off",
				"anti-slop/no-runtime-typeof": "off"
			}
		},
		{
			"files": [
				"apps/api/src/ingest/opportunity-ops.service.ts",
				"apps/api/src/ingest/guyana-opportunity.service.ts",
				"deploy/mac-mini/service-runner.ts",
				"apps/app/app/**/procurement/actions.ts",
				"apps/app/app/**/procurement/page.tsx",
				"apps/app/app/**/reset-password/page.tsx",
				"apps/mcp/src/redact.ts",
				"apps/mcp/src/index.ts",
				"apps/mcp/src/auth.ts",
				"apps/api/scripts/guyana-opportunity-collector.ts",
				"packages/db/scripts/outlook-scan-promote.ts",
				"packages/db/scripts/outlook-scan-dry-run.ts",
				"packages/db/scripts/verify-outlook-scan-promotion.ts",
				"packages/db/scripts/promote-identiti-pepboys-opportunity.ts",
				"packages/auth/src/password-reset-email.ts",
				"apps/app/lib/crm-mobile-actions.ts",
				"apps/api/src/email-ingest/email-ingest.controller.ts",
				"apps/api/src/email-ingest/email-ingest.contracts.ts",
				"apps/app/app/api/mobile-crm/[action]/route.ts",
				"apps/app/app/(app)/[slug]/mobile-actions/mobile-crm-actions.tsx",
				"apps/api/test/mailbox-email-ingest.spec.ts"
			],
			"rules": {
				"anti-slop/no-chained-type-assertions": "off",
				"anti-slop/no-conditional-empty-object-spread": "off",
				"anti-slop/no-known-value-widening": "off",
				"anti-slop/no-object-parameters": "off",
				"anti-slop/no-runtime-typeof": "off",
				"anti-slop/no-unknown-parameters": "off",
				"anti-slop/no-unknown-type-aliases": "off",
				"anti-slop/no-unsafe-dictionary-type": "off",
				"anti-slop/no-widen-then-assert": "off"
			}
		}
	]
}
